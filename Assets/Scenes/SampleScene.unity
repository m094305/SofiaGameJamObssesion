  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0523b6dd823a65549ae28034deebe6c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  portrait: {fileID: 1953607740}
  stolenItems: 2
  deathCutscene: {fileID: 2138649504}
  cutsceneWeapon: 0
  revealOnDeath: []
  spotRadius: 5
  talkRadius: 1.6
  spottedLines:
  - characterName: Narcissus
    line: A golden shrine to a human. Shrine, too good for it to not be to Me. So brilliant and clean, with Me it will be sublime.
    side: 1
    portraitOverride: {fileID: 0}
  greetingLines:
  - characterName: Knight
    line: Hello fellow! In your place I would be more careful around these woods, good idea don't you think?
    side: 0
    portraitOverride: {fileID: 0}
  attackedLines:
  - characterName: Knight
    line: Coward art thou. The use of foul trickery for what? God shall serve its justice upon you.
    side: 0
    portraitOverride: {fileID: 0}
  - characterName: Narcissus
    line: Filth thou art.
    side: 1
    portraitOverride: {fileID: 0}
  deathLines:
  - characterName: Narcissus
    line: Such a beauty of purpose, to make Me glamor. Shame it is not the finest jewel, barely suffices.
    side: 1
    portraitOverride: {fileID: 0}
  - characterName: Narcissus
    line: So good it is to be Me. The body of a god, all of Me!
    side: 1
    portraitOverride: {fileID: 0}
