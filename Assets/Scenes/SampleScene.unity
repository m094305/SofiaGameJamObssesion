    sound: {fileID: 0}
    lines:
    - characterName: Narcissus
      line: There it is again. A face the gods themselves would kneel to...
      side: 1
      portraitOverride: {fileID: 0}
    - characterName: Narcissus
      line: ...and yet the water shows what is missing. Treasures left on lesser bodies. Gold I let slip away.
      side: 1
      portraitOverride: {fileID: 0}
    - characterName: Narcissus
      line: Half a god is no god at all. I am not enough. Not like this.
      side: 1
      portraitOverride: {fileID: 0}
    - characterName: Narcissus
      line: Then let the water keep Me. Down there, at least, I will be whole.
      side: 1
      portraitOverride: {fileID: 0}
