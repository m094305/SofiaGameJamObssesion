  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: efa52129c657d1648af87f5efef968cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueLines:
  - characterName: Narcissus
    line: A silver shrine to a human. Shrine, too good for it to not be to Me. So brilliant and clean, with me it will be sublime.
    side: 0
    portraitOverride: {fileID: 0}
  - characterName: Knight
    line: Coward art thou. The use of foul trickery for what? God shall serve its justice upon you.
    side: 1
    portraitOverride: {fileID: 0}
  - characterName: Narcissus
    line: Filth thou art.
    side: 0
    portraitOverride: {fileID: 0}
  triggerOnce: 1
