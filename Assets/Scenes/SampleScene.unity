  m_Script: {fileID: 11500000, guid: 0523b6dd823a65549ae28034deebe6c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  portrait: {fileID: 1182618810}
  stolenItems: 1
  deathCutscene: {fileID: 586847094}
  cutsceneWeapon: 1
  revealOnDeath:
  - {fileID: 1495110661}
  spotRadius: 5
  talkRadius: 1.6
  spottedLines:
  - characterName: Narcissus
    line: Silk, a purple one at that. Something I wouldn't mind to Me to add. For my spark it will contribute.
    side: 1
    portraitOverride: {fileID: 0}
  greetingLines:
  - characterName: Merchant
    line: Hey fellow traveller. Looking to buy something for the journey ahead?
    side: 0
    portraitOverride: {fileID: 0}
  attackedLines: []
  deathLines:
  - characterName: Merchant
    line: The grace of Cephissus... Your beauty will be your demise!
    side: 0
    portraitOverride: {fileID: 0}
  - characterName: Narcissus
    line: Such bristly fabric. It will surely sit fine upon my clavicles, the finest ones there are. Long promised treasure I have retrieved, promised by the gods upon My birth.
    side: 1
    portraitOverride: {fileID: 0}
  - characterName: Narcissus
    line: Oh would you look at that. A fine metal sitting upon the wrong body. It will surely be befitting of Me to appropriate it.
    side: 1
    portraitOverride: {fileID: 0}
