  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0523b6dd823a65549ae28034deebe6c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  portrait: {fileID: 1391531845}
  stolenItems: 4
  deathCutscene: {fileID: 0}
  spotRadius: 5
  talkRadius: 1.6
  spottedLines:
  - characterName: Narcissus
    line: Such shame it is for the elderly. Doing such futile attempts for relevance, to keep up, even with the sparkle on her hands... Shame, it is not on Me.
    side: 1
    portraitOverride: {fileID: 0}
  - characterName: Narcissus
    line: Those rings, on fingers withered by age. Those rings are too brilliant for her.
    side: 1
    portraitOverride: {fileID: 0}
  greetingLines:
  - characterName: Grandma
    line: Hello sweeting. Are you lost here? Do you need a hand, maybe a warm meal?
    side: 1
    portraitOverride: {fileID: 0}
  attackedLines: []
  deathLines:
  - characterName: Narcissus
    line: For a hag with gold, her life wasn't worth much. For those rings though, life has plans including Me. Such closure must be for them, to be Mine.
    side: 1
    portraitOverride: {fileID: 0}
